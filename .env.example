# HTTPS-адрес отдельного приложения бронирования для production.
# Задайте перед next build. После изменения нужен повторный деплой.
NEXT_PUBLIC_BOOKING_WIDGET_URL=

# ERP_SITE_TOKEN включает новый серверный источник сайтов. Значение хранится только в .env.local.
# Пустое значение сохраняет совместимый источник ERP_COUNTRIES_URL.
ERP_SITE_TOKEN=
ERP_SITES_URL=https://dserver.warpoint.ru/api/wp_site/public/sites/
ERP_COUNTRIES_URL=https://gserver.warpoint.ru/api/site/v2/countries
ERP_REVALIDATE_SECONDS=300
# Логический домен города для localhost и Vercel preview.
PREVIEW_SITE_HOST=warpoint.ru
